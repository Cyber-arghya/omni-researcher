# ==============================================================================
# OpenDeepResearcher Environment Configuration Template
# Copy this file to .env and configure your desired providers.
# ==============================================================================

# --- LLM Provider Selection ---
# Options: ollama | nvidia | openai | gemini | anthropic | groq | deepseek | lmstudio | custom
LLM_PROVIDER=ollama

# Tier 1 (Fast/High-Volume): Used for query generation, relevance filtering, and summarization
LLM_FAST_MODEL=llama3.2:latest

# Tier 2 (Reasoning/Synthesis): Used for deep critique, outline structuring, and final report writing
LLM_DEEP_MODEL=deepseek-r1:latest

# Base URL (for local models or OpenAI-compatible proxies)
# Default for Ollama: http://localhost:11434/v1
# Default for LM Studio: http://localhost:1234/v1
# When running inside Docker to reach host Ollama: http://host.docker.internal:11434/v1
LLM_BASE_URL=http://localhost:11434/v1

# --- NVIDIA NIM API (https://build.nvidia.com) ---
# Set LLM_PROVIDER=nvidia to use NVIDIA hosted inference models
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# API Keys (leave empty or mock if running 100% locally with Ollama)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# --- Multi-Modal Vision Configuration ---
# Options: local | cloud | disabled
VISION_ENABLED=true
VISION_MODEL=llama3.2-vision:11b
# Cloud fallback option: gpt-4o or gemini-2.0-flash

# --- Web Search Providers ---
# Primary: ddg (DuckDuckGo - 100% free, no key needed) | searxng | tavily
SEARCH_PROVIDER=ddg
TAVILY_API_KEY=
SEARXNG_BASE_URL=http://localhost:8080

# --- Academic Research APIs ---
SEMANTIC_SCHOLAR_API_KEY=
NCBI_PUBMED_EMAIL=your_email@domain.com
NCBI_PUBMED_API_KEY=

# --- Cost & Token Safety Caps ---
MAX_COST_LIMIT_USD=2.00
MAX_TOTAL_TOKENS=150000

# --- Research Parameters ---
DEFAULT_RESEARCH_DEPTH=2
MAX_SEARCH_QUERIES_PER_STEP=5
MAX_SEARCH_RESULTS_PER_QUERY=6
INFORMATION_SATURATION_THRESHOLD=0.85

# --- Storage & Database Paths ---
STORAGE_DIR=./storage
REPORTS_DIR=./reports
SQLITE_DB_PATH=./storage/cache.db
KNOWLEDGE_GRAPH_PATH=./storage/knowledge_graph.json
CHROMA_PERSIST_DIR=./storage/vector_db

# --- Headless Browser / Firecrawl Scraper ---
HEADLESS_BROWSER_ENABLED=true
SCRAPER_TIMEOUT_SECONDS=15
